<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="PhoshOverview" parent="GtkBox">
    <property name="visible">1</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="AdwCarousel" id="carousel_running_activities">
        <signal name="notify::n-pages" handler="on_n_pages_changed" object="PhoshOverview" swapped="yes"/>
        <signal name="page-changed" handler="on_page_changed" object="PhoshOverview" swapped="yes"/>
        <property name="visible">0</property>
        <property name="spacing">18</property>
        <property name="margin-bottom">6</property>
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="reveal-duration">200</property>
        <property name="allow-long-swipes">1</property>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="evbox_app_grid">
        <property name="visible">1</property>
        <child>
          <object class="PhoshAppGrid" id="app_grid">
            <signal name="app-launched" handler="on_app_launched" object="PhoshOverview" swapped="yes"/>
            <property name="visible">1</property>
          </object>
        </child>
      </object>
    </child>
    <style>
      <class name="phosh-overview"/>
    </style>
  </template>
</interface>
